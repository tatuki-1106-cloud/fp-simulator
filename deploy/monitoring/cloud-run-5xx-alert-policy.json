{
  "displayName": "FP Simulator Cloud Run 5xx responses",
  "documentation": {
    "content": "Cloud RunのFP Simulatorで5xxレスポンスが5分間継続しています。Cloud Runログと直近のデプロイを確認してください。",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "5xx response rate is above zero",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"fp-simulator\" AND metric.type = \"run.googleapis.com/request_count\" AND metric.labels.response_code_class = \"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.labels.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "300s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "combiner": "OR",
  "enabled": true
}
